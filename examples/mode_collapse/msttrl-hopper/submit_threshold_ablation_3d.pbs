#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N msttrl-3d-thresh-ablation
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=08:00:00
#PBS -j oe

set -euo pipefail

module load apptainer/1.3.1

repo_dir=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL
container_image=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif
script_dir=examples/mode_collapse/msttrl-hopper

cd "$repo_dir"

job_tmp="$(mktemp -d "/tmp/verl-${PBS_JOBID}.XXXXXX")"
trap 'rm -rf -- "$job_tmp"' EXIT

echo "PBS job: $PBS_JOBID"
echo "Compute node: $(hostname)"

# (high_threshold low_threshold) pairs for the 3d threshold ablation.
# Reference config high=0.875 low=0.5 is already trained and is skipped.
threshold_pairs=(
  "0.875 0.375"
  "0.875 0.625"
  "0.75  0.5"
  "1.0   0.5"
)

for pair in "${threshold_pairs[@]}"; do
    read -r high low <<< "$pair"
    echo "Starting MSTTRL 3d high_threshold=${high} low_threshold=${low} at $(date)"
    apptainer exec --nv \
        --bind "$job_tmp:/tmp" \
        "$container_image" \
        bash "${script_dir}/run_msttrl_3d.sh" 0.9 "$high" 1337 "$low" 8
    echo "Finished MSTTRL 3d high_threshold=${high} low_threshold=${low} at $(date)"
done

echo "All threshold ablation runs done."
