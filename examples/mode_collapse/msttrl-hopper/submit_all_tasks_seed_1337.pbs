#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N simple-msttrl-all
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=5:00:00
#PBS -j oe

set -euo pipefail

module load apptainer/1.3.1

repo_dir=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL
container_image=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif
script_dir=examples/mode_collapse/msttrl-hopper

cd "$repo_dir"

job_tmp="$(mktemp -d "/tmp/verl-${PBS_JOBID}.XXXXXX")"
trap 'rm -rf -- "$job_tmp"' EXIT

for task in causal; do
    task_tmp="${job_tmp}/${task}"
    mkdir -p "$task_tmp"

    echo "Starting MSTTRL task=${task}, seed=1337 at $(date)"
    apptainer exec --nv \
        --bind "$task_tmp:/tmp" \
        "$container_image" \
        bash "${script_dir}/run_msttrl_${task}.sh" 0.9 0.875 1337
    echo "Finished MSTTRL task=${task}, seed=1337 at $(date)"
done
