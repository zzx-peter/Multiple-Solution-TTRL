#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N msttrl-causal-threshold-boundary
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=05:00:00
#PBS -j oe

set -euo pipefail

module load apptainer/1.3.1

repo_dir=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL
container_image=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif
script_path=examples/mode_collapse/msttrl-hopper-ablation-candidate/run_msttrl_causal.sh
result_root=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/result/mode_collapse

high_thresholds=(0.501)
low_thresholds=(0.5)

cd "$repo_dir"

job_tmp="$(mktemp -d "/tmp/verl-${PBS_JOBID}.XXXXXX")"
trap 'rm -rf -- "$job_tmp"' EXIT

for index in "${!high_thresholds[@]}"; do
    high_threshold="${high_thresholds[$index]}"
    low_threshold="${low_thresholds[$index]}"
    experiment_name="Qwen3-1.7B-causal-gated-ips-msttrl-high_${high_threshold}_low_${low_threshold}_seed_1337-boundary-ablation"
    run_tmp="${job_tmp}/high-${high_threshold}_low-${low_threshold}"
    mkdir -p "$run_tmp"

    echo "Starting Causal high=${high_threshold}, low=${low_threshold} at $(date)"
    apptainer exec --nv \
        --bind "$run_tmp:/tmp" \
        "$container_image" \
        bash "$script_path" 0.9 "$high_threshold" 1337 \
        "msttrl.low_threshold=${low_threshold}" \
        "msttrl.dump_dir=${result_root}/${experiment_name}" \
        "trainer.experiment_name=${experiment_name}" \
        "trainer.default_local_dir=${result_root}/${experiment_name}"
    echo "Finished Causal high=${high_threshold}, low=${low_threshold} at $(date)"
done
