#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N ttrl
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe

set -e
module load apptainer/1.3.1

cd /scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL

job_tmp="$(mktemp -d "/tmp/verl-${PBS_JOBID}.XXXXXX")"
trap 'rm -rf -- "$job_tmp"' EXIT

apptainer exec --nv \
  --bind "$job_tmp:/tmp" \
  /scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif \
  bash examples/mode_collapse/ttrl/run_ttrl_boolean.sh
