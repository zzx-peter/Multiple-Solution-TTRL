#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N msttrl-phi-causal-seeds
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=16:00:00
#PBS -j oe

set -e
module load apptainer/1.3.1

cd /scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL

job_tmp="$(mktemp -d "/tmp/verl-${PBS_JOBID}.XXXXXX")"
trap 'rm -rf -- "$job_tmp"' EXIT

for seed in 42 3447; do
  echo "Starting causal seed=${seed} at $(date)"
  apptainer exec --nv \
    --bind "$job_tmp:/tmp" \
    /scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif \
    bash examples/mode_collapse/msttrl-hopper-Phi/run_msttrl_causal.sh 0.9 0.875 "$seed"
  echo "Finished causal seed=${seed} at $(date)"
done
