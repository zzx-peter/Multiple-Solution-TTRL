#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N msttrl-phi-lambda
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=03:00:00
#PBS -j oe

set -euo pipefail

repo_dir="/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL"
container_image="/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif"
lambda_values=(0.9)

module load apptainer/1.3.1
cd "$repo_dir"

echo "PBS job: $PBS_JOBID"
echo "Compute node: $(hostname)"

for lambda_value in "${lambda_values[@]}"; do
    echo "Starting gated_ips_grpo_lambda=$lambda_value at $(date)"
    apptainer exec --nv "$container_image" \
        bash examples/mode_collapse/msttrl-hopper-Phi/run_msttrl_causal.sh "$lambda_value"
    echo "Finished gated_ips_grpo_lambda=$lambda_value at $(date)"
done
