#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N no-gated-msttrl-aggregate
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=00:15:00
#PBS -j oe

set -euo pipefail

module load apptainer/1.3.1

repo_dir=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL
container_image=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif
aggregate_script=examples/mode_collapse/msttrl-hopper-ablation-gated-ips/aggregate_seed_results.py

cd "$repo_dir"
apptainer exec "$container_image" python3 "$aggregate_script"
