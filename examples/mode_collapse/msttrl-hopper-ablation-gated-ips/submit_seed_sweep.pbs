#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N no-gated-msttrl-seeds
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=06:00:00
#PBS -J 0-11
#PBS -j oe

set -euo pipefail

module load apptainer/1.3.1

repo_dir=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL
result_root=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/result/mode_collapse
container_image=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif
script_dir=examples/mode_collapse/msttrl-hopper-ablation-gated-ips

tasks=(causal causal causal causal 3d 3d 3d 3d boolean boolean boolean boolean)
seeds=(0 1 42 3447 0 1 42 3447 0 1 42 3447)

task="${tasks[PBS_ARRAY_INDEX]}"
seed="${seeds[PBS_ARRAY_INDEX]}"

case "$task" in
    causal)
        experiment_name="Qwen3-1.7B-causal-no-gated-ips-msttrl_lambda_0.9_high_0.875_seed_${seed}_2"
        final_step=360
        ;;
    3d)
        experiment_name="Qwen3-1.7B-3d-no-gated-ips-msttrl_lambda_0.9_high_0.875_low_0.5_verifiern_8_seed_${seed}"
        final_step=120
        ;;
    boolean)
        experiment_name="Qwen3-1.7B-boolean-no-gated-ips-msttrl_lambda_0.9_high_0.875_seed_${seed}"
        final_step=90
        ;;
    *)
        echo "Unsupported task: $task" >&2
        exit 2
        ;;
esac

checkpoint="${result_root}/${experiment_name}/global_step_${final_step}/actor/model_world_size_1_rank_0.pt"
if [[ -s "$checkpoint" ]]; then
    echo "SKIP completed task=${task}, seed=${seed}: ${checkpoint}"
    exit 0
fi

cd "$repo_dir"

job_tmp="$(mktemp -d "/tmp/verl-${PBS_JOBID}.XXXXXX")"
trap 'rm -rf -- "$job_tmp"' EXIT

echo "Starting no-gated-ips MSTTRL task=${task}, seed=${seed} at $(date)"
apptainer exec --nv \
    --bind "$job_tmp:/tmp" \
    "$container_image" \
    bash "${script_dir}/run_msttrl_${task}.sh" 0.9 0.875 "$seed"

if [[ ! -s "$checkpoint" ]]; then
    echo "Training exited successfully but final checkpoint is missing: $checkpoint" >&2
    exit 1
fi
echo "Finished no-gated-ips MSTTRL task=${task}, seed=${seed} at $(date)"
