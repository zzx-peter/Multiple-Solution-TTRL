#!/bin/bash
#PBS -P CFP04-CF-024
#PBS -q auto
#PBS -N msttrl-3d-verifiern
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=03:00:00
#PBS -j oe

set -euo pipefail

module load apptainer/1.3.1

repo_dir=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/code/Multiple-Solution-TTRL
container_image=/scratch/Projects/CFP-04/CFP04-CF-024/ophv164/containers/verl-vllm017.sif
script_dir=examples/mode_collapse/msttrl-hopper

cd "$repo_dir"

job_tmp="$(mktemp -d "/tmp/verl-${PBS_JOBID}.XXXXXX")"
trap 'rm -rf -- "$job_tmp"' EXIT

echo "PBS job: $PBS_JOBID"
echo "Compute node: $(hostname)"

# verifier_n ablation for the 3d task.
# Reference config verifier_n=8 (high=0.875 low=0.5) is already trained.
verifier_n_values=(4)

for verifier_n in "${verifier_n_values[@]}"; do
    echo "Starting MSTTRL 3d verifier_n=${verifier_n} at $(date)"
    apptainer exec --nv \
        --bind "$job_tmp:/tmp" \
        "$container_image" \
        bash "${script_dir}/run_msttrl_3d.sh" 0.9 0.875 1337 0.5 "$verifier_n"
    echo "Finished MSTTRL 3d verifier_n=${verifier_n} at $(date)"
done

echo "All verifier_n ablation runs done."
